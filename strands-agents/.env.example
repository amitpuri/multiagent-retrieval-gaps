# AWS Bedrock Configuration (Anthropic Claude on Bedrock)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5

# Amazon Bedrock AgentCore Configuration (Managed Memory)
AGENTCORE_MEMORY_ID=mem-clinical-decision-support
AGENTCORE_SESSION_ID=session-default
AGENTCORE_ACTOR_ID=clinician-001

# Execution Mode: set to true or 1 for offline testing without AWS credentials
STRANDS_OFFLINE_MODE=false
