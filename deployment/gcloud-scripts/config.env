# Google Cloud Deployment Configuration for Clinical Agent Harness
# Source this file or edit parameters before running deploy.sh / deploy.ps1

# GCP Project ID (leave empty to auto-detect from active gcloud config)
PROJECT_ID=""

# Deployment Region (e.g., europe-west1, us-central1, us-east1)
REGION="europe-west1"

# Service & Image Names
SERVICE_NAME="clinical-agent-harness"
REPO_NAME="clinical-agents"
IMAGE_NAME="clinical-adk-harness"
IMAGE_TAG="latest"

# Cloud Run Scaling & Resource Specs
PORT=8000
MIN_INSTANCES=0
MAX_INSTANCES=5
CPU="1"
MEMORY="1Gi"
CONCURRENCY=80
TIMEOUT="300s"

# Access & Security
ALLOW_UNAUTHENTICATED="true"

# Secret / API Keys (will search local .env if empty)
# GEMINI_API_KEY=""
# HARNESS_API_TOKENS=""
