# Azure Deployment Configuration for Clinical Agent Decision Support
# Source this file or edit parameters before running deploy.sh / deploy.ps1

# Azure Resource Group & Location
RESOURCE_GROUP="rg-clinical-agents"
LOCATION="eastus"

# Azure Container Registry (must be alphanumeric, 5-50 chars; leave empty to auto-generate unique name)
ACR_NAME=""

# Container Apps Environment & App Name
ENVIRONMENT_NAME="cae-clinical-agents"
APP_NAME="maf-clinical-agents"
IMAGE_NAME="agent-framework"
IMAGE_TAG="latest"

# Compute Specs & Scaling
PORT=8000
CPU="1.0"
MEMORY="2.0Gi"
MIN_REPLICAS=0
MAX_REPLICAS=5

# Azure AI Foundry & Model Configuration (Azure CAF Standard: ais-*, aiproj-*)
# Uses existing Foundry account/project if available or creates in RESOURCE_GROUP
AI_FOUNDRY_ACCOUNT_NAME="ais-clinical-agents"
AI_FOUNDRY_PROJECT_NAME="aiproj-clinical-agents"
AI_FOUNDRY_RESOURCE_GROUP="rg-clinical-agents"
FOUNDRY_MODEL="gpt-5"

# Optional fallback keys (if not using Managed Identity with Azure AI Foundry)
# OPENAI_API_KEY=""
