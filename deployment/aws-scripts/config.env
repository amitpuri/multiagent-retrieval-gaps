# AWS Deployment Configuration for Clinical Agent Decision Support (strands-agents)
# Source this file or edit parameters before running deploy.sh / deploy.ps1

# AWS Deployment Region (e.g., us-east-1, eu-west-1)
AWS_REGION="us-east-1"

# Service & ECR Repository Names
SERVICE_NAME="strands-clinical-agents"
ECR_REPO_NAME="strands-clinical-agents"
IMAGE_TAG="latest"

# AWS App Runner Compute Specs (1024 = 1 vCPU, 2048 = 2 GB RAM)
PORT=8000
CPU="1024"
MEMORY="2048"

# IAM Role Names
ECR_ACCESS_ROLE_NAME="AppRunnerECRAccessRole"
INSTANCE_ROLE_NAME="ClinicalAgentBedrockRole"

# Optional Anthropic API Key (if not relying purely on IAM Bedrock access)
# ANTHROPIC_API_KEY=""
