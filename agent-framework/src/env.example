# ── Option A: Azure AI Foundry (preferred for production) ──────────────────────
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-project.api.azureml.ms
FOUNDRY_MODEL=gpt-5

# ── Option B: Azure OpenAI direct endpoint ──────────────────────────────────────
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_API_KEY=your-azure-key

# ── Option C: OpenAI Agents SDK (local / fallback) ─────────────────────────────
# Use this if Azure AI Foundry is not available or for local development.
# Requires: pip install openai-agents
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

# ── Offline mode (no API calls — deterministic mock for CI) ────────────────────
MAF_OFFLINE_MODE=false